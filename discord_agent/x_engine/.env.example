# Company Branding & Pitch
COMPANY_NAME=ApexTrading
COMPANY_ONE_LINER=Next-gen AI trading terminal for crypto & equities with automated backtesting and real-time smart signals.
COMPANY_CTA=Check out our live market insights or DM us for early access!
COMPANY_URL=https://apextrading.ai

# Search & Targeting Configuration
# Target keywords (comma-separated)
TARGET_KEYWORDS=crypto, BTC, bitcoin, stocks, stock market, $BTC, $ETH, crypto trading
# Negative keywords to filter out scams, spam, and airdrops
NEGATIVE_KEYWORDS=airdrop, giveaway, free coins, dm me for signals, whatsapp group, presale, claim free, 100x gem

# Media & Image Attachment
# Automatically upload & attach an image from the folder alongside the comment
ATTACH_IMAGE=true
MEDIA_IMAGE_PATH=./media

# Optional: Direct Auth Token (if you don't want to log in via browser)
# Obtain from DevTools (F12) -> Application -> Cookies -> 'auth_token' on x.com
X_AUTH_TOKEN=

# 100% Fully Autonomous Hands-Free Controls
# DRY_RUN: If false, comments will be published live to X automatically
DRY_RUN=false
# AUTO_START: If true, engine starts immediately upon launch with zero human approval
AUTO_START=true

# Safety & Anti-Ban Rate Limiting
MIN_DELAY_SECONDS=90
MAX_DELAY_SECONDS=240
DAILY_COMMENT_LIMIT=30

# Browser Configuration
# Set to false to see browser window (essential for first-time login)
HEADLESS=false
BROWSER_DATA_DIR=./browser_data

# Web Management Dashboard
WEB_HOST=127.0.0.1
WEB_PORT=8000

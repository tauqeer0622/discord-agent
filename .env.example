# ============================================================
#  Discord Command Center & X Autonomous Engine — Environment Variables
# ============================================================

# ── Discord Userbot Settings ─────────────────────────────────
# Your Discord user token (Account authorization token)
DISCORD_TOKEN=

# Private Control Server ID where threads will be mirrored
CONTROL_SERVER_ID=

# Channel ID inside Control Server where threads will be posted
CONTROL_CHANNEL_ID=

# Web Dashboard Port & Admin Password
PORT=10000
ADMIN_PASSWORD=admin123

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# ── AI Engine (OpenAI) ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Turso Cloud Database (Primary 2.24M Member Store) ────────
USE_TURSO=true
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── MongoDB Atlas (Message Thread & Backup Store) ─────────────
MONGODB_URI=
MONGODB_DB_NAME=discord_agent_db

# ── Telegram Bio & Scraper Integration ───────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ── Discord OAuth2 & Bot Verification Cards (Optional) ───────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:10000/api/oauth2/callback

# ── Autonomous X (Twitter) Engine ────────────────────────────
COMPANY_NAME=BR Axis
COMPANY_ONE_LINER=Next-gen crypto and equities analytics platform providing real-time on-chain flows and automated market signals.
COMPANY_CTA=Join our VIP market signals server: https://discord.gg/4av5x7Faa3
COMPANY_URL=https://x.com/tauqeer0622

# X Authentication Token (Session persistence cookie)
X_AUTH_TOKEN=

# Search & Targeting Keywords
TARGET_KEYWORDS=crypto, BTC, bitcoin, stocks, stock market, $BTC, $ETH, crypto trading
NEGATIVE_KEYWORDS=airdrop, giveaway, free coins, dm me for signals, whatsapp group, presale, claim free, 100x gem

# Infographic Card Attachment & Cyclical Rotation
ATTACH_IMAGE=true
IMAGE_ROTATION_HOURS=2.0
MEDIA_IMAGE_PATH=./discord_agent/x_engine/media
BROWSER_DATA_DIR=./discord_agent/x_engine/browser_data

# AWS S3 Live Market News Data Feed
S3_ENABLED=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_JSON_KEY=latest_news.json
S3_PUBLIC_URL=

# Autonomous Operating Controls
DRY_RUN=false
AUTO_START=false
MIN_DELAY_SECONDS=240
MAX_DELAY_SECONDS=480
DAILY_COMMENT_LIMIT=12

# Browser Mode: Set to false on RDP for full visual desktop execution!
HEADLESS=false

# Discord Member Scraping Controls (2.24M+ members already captured in Turso)
ENABLE_MEMBER_SCRAPING=false
AUTO_MEMBER_SYNC_ENABLED=false
